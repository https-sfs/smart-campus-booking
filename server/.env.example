# Copy this file to server/.env and replace values that belong to your machine.
# Never commit server/.env.

PORT=5000
NODE_ENV=development

# Local MongoDB, or the connection string from your own MongoDB Atlas account.
MONGODB_URI=mongodb://127.0.0.1:27017/smart-campus-booking

# Exact origin of the Vite development server.
# For a hosted HTTPS site, set this to that site origin.
CLIENT_ORIGIN=http://localhost:5173

# At least 32 random characters. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Used only by npm run seed:admin. Registration cannot create this account.
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@campus.test
ADMIN_PASSWORD=replace-with-a-strong-password
