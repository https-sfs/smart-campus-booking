{
  "name": "smart-campus-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Campus Service Booking and Management System",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "postinstall": "npm run install:all",
    "dev": "concurrently -k -n server,client -c blue,green npm:dev:server npm:dev:client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "start": "npm run start --prefix server",
    "test": "npm test --prefix server",
    "seed:admin": "npm run seed:admin --prefix server",
    "seed:services": "npm run seed:services --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
